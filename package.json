{
  "name": "dsh-plugin-smart-ratelimit",
  "version": "1.0.4",
  "description": "DSH 通用多提供商智能限速与容错插件 - 支持 RPM/TPM 双维度令牌桶、429 自学习历史、React 设置面板",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/ui/client.js"
  },
  "scripts": {
    "test": "node --test test/dualRateLimiter.test.js test/integration.test.js",
    "smoke": "node scripts/smoke-server.mjs && node scripts/smoke-client.mjs",
    "probe": "node scripts/probeModels.mjs",
    "lint": "echo \"No linter configured\""
  },
  "keywords": [
    "dsh",
    "plugin",
    "rate-limit",
    "token-bucket",
    "nvidia",
    "agnes-ai",
    "smart-ratelimit"
  ],
  "author": "DSH Plugin Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "js-yaml": "^5.5.0"
  },
  "files": [
    "src/index.js",
    "src/core/tokenEstimator.js",
    "src/limiter/dualRateLimiter.js",
    "src/config/configPaths.js",
    "src/config/configMerger.js",
    "src/config/providerDiscovery.js",
    "src/intercept/requestInterceptor.js",
    "src/intercept/nvcfPoller.js",
    "src/history/metricsTracker.js",
    "src/ui/RateLimitSettingsView.css",
    "src/ui/client.js",
    "config/default_presets.json",
    "config/rate_limit_settings.json",
    "config/rate_limit_429_history.json",
    "config/probed_model_limits.json",
    "scripts/probeModels.mjs",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "plugin": {
      "name": "smart-ratelimit",
      "displayName": "智能限速中心",
      "entry": "src/index.js",
      "settings": {
        "panel": "src/ui/client.js",
        "category": "network"
      }
    },
    "client": {
      "platform": "web"
    }
  }
}
